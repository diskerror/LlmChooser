{
    "name": "diskerror/llmchooser",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "diskerror/typed": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Typed",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "LLMchooser\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload-dev": {
        "psr-4": {
            "LLMchooser\\Tests\\": "tests/"
        }
    }
}
