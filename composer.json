{
    "name": "diskerror/llmchooser",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "diskerror/typed": "1.0.*",
        "diskerror/p_lib": "dev-master",
        "ext-pcntl": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/diskerror/p_lib.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "LlmChooser\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "LlmChooser\\Tests\\": "tests/"
        }
    }
}
