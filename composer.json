{
    "name": "diskerror/llmchooser",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "diskerror/typed": "*",
        "diskerror/p_lib": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Typed",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../p_lib",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "LlmChooser\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "LlmChooser\\Tests\\": "tests/"
        }
    }
}
