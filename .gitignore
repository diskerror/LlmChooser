/vendor/
/.idea/
/composer.lock
/storage/presets/*
!/storage/presets/.gitkeep
/storage/engines/*
!/storage/engines/.gitkeep
!/storage/engines/llama-ngram.json
/storage/logs/*
!/storage/logs/.gitkeep
.phpunit.result.cache

# Generated by the scanner; rebuilt on demand.
/storage/model_cache.json

# Runtime instance state; rebuilt by reconciling against real processes.
/storage/runtime_state.json
.DS_Store

# Per-engine help text captured from the binary (generated).
/storage/help/*
!/storage/help/.gitkeep
